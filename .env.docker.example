# Copy to .env.docker and fill in. Consumed by docker-compose.yml, `make dock`,
# `make backup` and ./update.sh — all of them pass --env-file .env.docker.
#
# Frontend and backend are ONE origin: nginx serves the SPA and proxies
# /api/, /admin/ and /static/ to Django, so there is no API URL to keep in sync
# and no CORS to configure.

# --- Django ---
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-base64-48
DEBUG=False
# The public hostname, plus localhost,127.0.0.1 — those two are REQUIRED, not
# cosmetic. The backend healthcheck curls 127.0.0.1:8000/login/; drop them and Django
# answers 400 DisallowedHost, backend stays `unhealthy` forever, and `frontend`
# (depends_on: service_healthy) never leaves `Created`. Symptom is a dead site, not
# a red healthcheck. Django's own default here applies only when the var is UNSET.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app.example.com
# Same-origin means CORS is inert, but this list still feeds CSRF_TRUSTED_ORIGINS:
# without the public https origin here, admin form POSTs fail with
# "Origin checking failed". Must be the scheme+host users actually reach.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Database ---
# POSTGRES_HOST=postgres selects the compose service (empty => SQLite, host dev only).
POSTGRES_DB=app
POSTGRES_USER=app
# Read ONLY by initdb, on the first boot with an empty data dir. Change it later — or
# boot once before this file is filled in — and the cluster keeps the OLD credentials
# while the backend sends the new ones: crash-loop on `password authentication failed`.
# `down` (and so `make dock` / update.sh) keeps the volume, so redeploying never fixes
# it. Recover with `ALTER ROLE <user> WITH PASSWORD ...` (keeps data) or `down -v`
# (wipes the database). Note 127.0.0.1 is `trust` in pg_hba, so testing from inside the
# postgres container succeeds even while the backend fails — test over `-h postgres`.
POSTGRES_PASSWORD=CHANGE-ME-compose-aborts-if-unset
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Mayar (payments) ---
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
PAYMENT_REDIRECT_URL=https://app.example.com/

# --- URLs --- (one origin, so these are the same host)
SITE_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

# --- Frontend build args (compose `frontend` service, baked in at build time) ---
# VITE_API_URL is intentionally absent: the SPA calls relative /api/v1 and nginx
# proxies it, which keeps the built image environment-agnostic.
VITE_GOOGLE_CLIENT_ID=
# Published on 127.0.0.1 only — point your reverse proxy / tunnel at this port.
FRONTEND_PORT=8080
