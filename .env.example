# --- Django ---
SECRET_KEY=
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Feeds CSRF_TRUSTED_ORIGINS (CORS is inert same-origin): the nginx origin,
# plus :5173 for the `make web` dev server.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ---
# Leave POSTGRES_HOST empty for SQLite (host dev). Compose: POSTGRES_HOST=postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Mayar (payments) ---
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
PAYMENT_REDIRECT_URL=http://localhost:5173/

# --- URLs ---
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Frontend build args (compose `frontend` service, baked in at build time) ---
# Frontend and backend are ONE origin: nginx serves the SPA and proxies /api/,
# /admin/ and /static/ to Django, so VITE_API_URL is intentionally absent — the SPA
# calls relative /api/v1 and the built image stays environment-agnostic.
# Vite inlines these, so changing one needs `docker compose build frontend`.
VITE_GOOGLE_CLIENT_ID=
# Published on 127.0.0.1 only — put a reverse proxy / tunnel in front of it.
FRONTEND_PORT=8080
